# PLANTILLA — copiar el contenido en Streamlit Cloud (Settings -> Secrets).
#
# ESTE ARCHIVO NO LLEVA CLAVES DE VERDAD y el de verdad (secrets.toml) NO se
# versiona: está en .gitignore. El repositorio es público.
#
# En Streamlit Cloud los secretos se pegan en la web de la app, no en el repo.
# Para correrla en un PC, copiar este archivo como `secrets.toml` en esta misma
# carpeta y poner ahí la clave.

# ---------------------------------------------------------------------------
# ÚNICO SECRETO OBLIGATORIO
# ---------------------------------------------------------------------------
# Clave de la base de datos de Supabase (Project Settings -> Database).
# Con esto puesto, la app lee y escribe en Supabase.
# Sin esto, la app arranca igual pero vuelve a usar GitHub como antes.
SUPABASE_DB_PASSWORD = "pegar-aqui-la-clave"


# ---------------------------------------------------------------------------
# OPCIONALES — solo si algo cambia de lugar
# ---------------------------------------------------------------------------
# El proyecto de Supabase y su clave pública ya vienen por defecto en el código
# (la clave `anon` es pública por diseño: sin un vale válido no abre nada).
# Solo hace falta declararlas si algún día se cambia de proyecto.
# SUPABASE_URL      = "https://ordgsglujssgzmnlmcus.supabase.co"
# SUPABASE_ANON_KEY = "eyJ..."

# Token de GitHub: YA NO SE NECESITA. Con Supabase activo, la app no vuelve a
# tocar GitHub. Se deja documentado solo por si se quisiera volver atrás.
# GITHUB_TOKEN = "ghp_..."

# Informe de indicadores de Power BI, si se usa ese módulo.
# PBI_INDICADORES_URL = "https://..."

# Consulta de patente por API externa, si se reactiva.
# BOOSTR_API_KEY = "..."
